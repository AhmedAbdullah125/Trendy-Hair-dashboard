# ─── API ──────────────────────────────────────────────────────────────────
# Base URL of the Laravel API, without a trailing slash.
# Used for every request and to resolve relative image paths.
VITE_API_BASE_URL=https://trandyhairapp.com/api

# ─── OAuth client ─────────────────────────────────────────────────────────
# Passport client id for this application.
VITE_OAUTH_CLIENT_ID=

# WARNING — this is a temporary arrangement, not a secure one.
#
# Vite inlines import.meta.env values into the JS bundle at build time, so any
# value set here is readable by anyone who loads the app. It is set only
# because the backend currently validates `client_secret` as required
# (RequiresUserPassportClient::passportRules).
#
# Leave this EMPTY once the backend converts this to a public client: the app
# omits `client_secret` entirely when it is unset, which is the PKCE-compatible
# payload. No code change is needed.
#
# The previously hardcoded secrets must be rotated — treat them as compromised.
VITE_OAUTH_CLIENT_SECRET=
